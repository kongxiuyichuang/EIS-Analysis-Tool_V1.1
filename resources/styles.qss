/* TLM V2.0 Global Stylesheet */
QMainWindow {
    background-color: #f0f2f5;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
    font-family: "Microsoft YaHei UI";
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #1a237e;
}

QPushButton {
    font-family: "Microsoft YaHei UI";
    font-size: 10pt;
    padding: 6px 16px;
    border: 1px solid #c0c0c0;
    border-radius: 4px;
    background-color: #ffffff;
    color: #212121;
}

QPushButton:hover {
    background-color: #e3f2fd;
    border-color: #2962ff;
}

QPushButton:pressed {
    background-color: #bbdefb;
}

QPushButton#btnFit {
    background-color: #1a237e;
    color: white;
    border: none;
    font-weight: bold;
}

QPushButton#btnFit:hover {
    background-color: #283593;
}

QPushButton#btnExport {
    background-color: #2e7d32;
    color: white;
    border: none;
}

QPushButton#btnExport:hover {
    background-color: #388e3c;
}

QLineEdit, QDoubleSpinBox {
    font-family: "Consolas";
    font-size: 9pt;
    padding: 3px 6px;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    background-color: #fafafa;
}

QLineEdit:focus, QDoubleSpinBox:focus {
    border-color: #2962ff;
    background-color: #ffffff;
}

QComboBox {
    font-family: "Microsoft YaHei UI";
    font-size: 10pt;
    padding: 4px 8px;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
}

QComboBox:hover {
    border-color: #2962ff;
}

QTableWidget {
    font-family: "Consolas";
    font-size: 9pt;
    gridline-color: #e0e0e0;
    background-color: #ffffff;
    alternate-background-color: #f5f5f5;
}

QHeaderView::section {
    background-color: #1a237e;
    color: white;
    font-weight: bold;
    padding: 4px 8px;
    border: none;
}

QTextEdit, QPlainTextEdit {
    font-family: "Consolas";
    font-size: 9pt;
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #2962ff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #1a237e;
}

QCheckBox {
    font-family: "Microsoft YaHei UI";
    font-size: 9pt;
}

QTabWidget::pane {
    border: 1px solid #e0e0e0;
    border-top: none;
}

QTabBar::tab {
    font-family: "Microsoft YaHei UI";
    font-size: 9pt;
    padding: 6px 16px;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1a237e;
    font-weight: bold;
    border-bottom: 2px solid #1a237e;
}

QTabBar::tab:hover:!selected {
    background: #e3f2fd;
}

/* FloatingProgress — 绘图区中央悬浮进度 */
QFrame#fpFrame {
    background-color: rgba(250, 250, 252, 235);
    border: 1px solid #b0bec5;
    border-radius: 8px;
}

QLabel#fpLabel {
    font-family: "Microsoft YaHei UI";
    font-size: 10pt;
    color: #1a237e;
}

QProgressBar#fpBar {
    border: 1px solid #90a4ae;
    border-radius: 7px;
    background-color: #eceff1;
    text-align: center;
}

QProgressBar#fpBar::chunk {
    border-radius: 6px;
    background-color: #2962ff;
}
